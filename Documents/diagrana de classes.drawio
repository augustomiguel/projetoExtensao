        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class TravelDownloader {\n    +int year\n    +str base_data_folder\n    +str zip_file_name\n    +str csv_dest_folder\n    +fetch_raw_data() tuple\n    +load_csvs() tuple\n    -_download_csv() bool\n    -_unzip_file() bool\n    -_normalize_columns(df, var_name) DataFrame\n  }\n\n  class DataCleaner {\n    +str corrections_file\n    +execute(travel_df, ticket_df, segment_df) tuple\n    -_load_corrections_dict() dict\n  }\n\n  class DistanceManager {\n    +GeoCacheManager geocoder\n    +str lookup_file\n    +execute(segment_df) DataFrame\n  }\n\n  class EmissionsCalculator {\n    +float EF_ECO_VERY_SHORT\n    +float EF_ECO_SHORT\n    +float EF_ECO_LONG\n    +int DH_LIMIT\n    +int SH_LIMIT\n    +execute(segment_df) DataFrame\n  }\n\n  class MasterBuilder {\n    +int year\n    +str output_folder\n    +str master_out_file\n    +execute(df_aggregated, travel_df, ticket_df) DataFrame\n    -_classify_affiliation(row) str\n  }\n\n  class Filter {\n    +int year\n    +str year_data_folder\n    +str master_all_file\n    +DataFrame df_all\n    +filter_and_save(org_short_name)\n    -_load_master_all_file() DataFrame\n  }\n\n  class GeoCacheManager {\n    +str user_agent\n    +DataFrame coordinates_map\n    +set not_found_cities\n    +get_coordinates(cities_list) DataFrame\n    +calculate_haversine(lat1, lon1, lat2, lon2) float\n  }\n\n  class MetricsCalculator {\n    +int year\n    +dict correction_factors\n    +prepare_numeric_data(df) DataFrame\n    +calculate_monthly_summary(df) DataFrame\n    +calculate_dynamic_baseline(org, processing_years) dict\n    +calculate_indicators_and_scores(raw_df, baseline) dict\n  }\n\n  class ReportGenerator {\n    +int year\n    +str data_folder\n    +str monthly_reports_folder\n    +MetricsCalculator calculator\n    +generate_monthly_report(org)\n    +generate_consolidated_dashboard(org, baseline)\n    +generate_index_panel(org, baseline)\n    +generate_institutional_comparison(orgs)\n    +merge_pdfs_into_one(org)\n    +generate_excel_matrix(org, selected_years)\n  }\n\n  class TravelProcessor {\n    +int year\n    +GeoCacheManager geocoder\n    +DataCleaner cleaner\n    +DistanceManager distance_manager\n    +EmissionsCalculator emissions_calculator\n    +MasterBuilder builder\n    +load_data(travel_df, ticket_df, segment_df)\n    +process_all() DataFrame\n  }\n\n  TravelProcessor *-- DataCleaner\n  TravelProcessor *-- DistanceManager\n  TravelProcessor *-- EmissionsCalculator\n  TravelProcessor *-- MasterBuilder\n  TravelProcessor ..&gt; GeoCacheManager\n  DistanceManager ..&gt; GeoCacheManager\n  ReportGenerator *-- MetricsCalculator\n\n  style TravelProcessor fill:#e1f5fe,stroke:#01579b\n  style ReportGenerator fill:#e1f5fe,stroke:#01579b\n  style DataCleaner fill:#f5f5f5,stroke:#333\n  style DistanceManager fill:#f5f5f5,stroke:#333\n  style EmissionsCalculator fill:#f5f5f5,stroke:#333\n  style MasterBuilder fill:#f5f5f5,stroke:#333\n  style GeoCacheManager fill:#f5f5f5,stroke:#333\n  style MetricsCalculator fill:#f5f5f5,stroke:#333&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7Uyocxsx0SGVR4i5tyQw-335">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

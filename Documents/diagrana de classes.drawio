        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n  subgraph Lane1 [\&quot;Orchestration (main.py)\&quot;]\n    direction TB\n    Start((Start)) --&gt; P1[\&quot;Execute Annual Pipeline (Years and Institutions)\&quot;]\n    P1 --&gt; P2[\&quot;Define Baseline Years and Analysis Years\&quot;]\n  end\n\n  subgraph Lane2 [\&quot;Ingestion and Cleaning (Downloader &amp; DataCleaner)\&quot;]\n    direction TB\n    P2 --&gt; P3[\&quot;Download ZIP from Transparency Portal\&quot;]\n    P3 --&gt; D1[/\&quot;Extract Raw CSVs: Travel, Ticket, and Segment\&quot;/]\n    D1 --&gt; B1{\&quot;Are there valid data?\&quot;}\n    B1 -- No --&gt; End1((End: Skip Year))\n    B1 -- Yes --&gt; P4[\&quot;Filter &#39;AIR&#39; transport and apply city corrections dictionary\&quot;]\n  end\n\n  subgraph Lane3 [\&quot;Calculation Engine (GeoCache &amp; Emissions)\&quot;]\n    direction TB\n    P4 --&gt; B2{\&quot;Are cities in Local Cache?\&quot;}\n    B2 -- No --&gt; P5[\&quot;Query Nominatim API\&quot;]\n    B2 -- Yes --&gt; P6[\&quot;Calculate Haversine Distance (GCD) between airports\&quot;]\n    P5 --&gt; P6\n    P6 --&gt; P7[\&quot;Apply Emission Factors by distance range (Short/Long)\&quot;]\n    P7 --&gt; P8[\&quot;Classify Affiliations (Professor, Academic, etc.) and Build ALL Master File\&quot;]\n  end\n\n  subgraph Lane4 [\&quot;Analytics (Metrics &amp; Reports)\&quot;]\n    direction TB\n    P8 --&gt; P9[\&quot;Filter data by Institution (UFPB / UFCG)\&quot;]\n    P9 --&gt; B3{\&quot;Is it a Baseline year?\&quot;}\n    B3 -- Yes --&gt; C1[(Save averages: Expenses and Emissions)]\n    C1 --&gt; End2((Wait for next year))\n    B3 -- No --&gt; P10[\&quot;Adjust financial values via IPCA inflation\&quot;]\n    P10 --&gt; P11[\&quot;Calculate Sustainability Scores (PIBIC Methodology)\&quot;]\n    P11 --&gt; D2[/\&quot;Generate PDFs: Monthly Dashboard, Index Panel, and Institutional Comparison\&quot;/]\n    D2 --&gt; D3[/\&quot;Export Consolidated Excel Matrix (tCO2eq)\&quot;/]\n    D3 --&gt; End3((Cycle Completed))\n  end\n\n  style Lane1 fill:#e1f5fe,stroke:#01579b\n  style Lane2 fill:#fff3e0,stroke:#e65100\n  style Lane3 fill:#e8f5e9,stroke:#1b5e20\n  style Lane4 fill:#f3e5f5,stroke:#4a148c&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7Uyocxsx0SGVR4i5tyQw-285">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
